# Caddyfile — used in production (docker-compose.prod.yml).
# In dev, Vite proxies /api directly; Caddy is not involved.
#
# Site address comes from the $ARTHOS_DOMAIN env var (set in the host-only .env):
#   - a real domain (e.g. arthos.example.com) -> Caddy serves auto-HTTPS via
#     ACME/Let's Encrypt on :443 (Option A). REQUIRES the domain's DNS A-record
#     to already point at the VM IP before ACME can succeed.
#   - ":80" -> plain HTTP, intended to sit BEHIND Cloudflare which terminates TLS
#     (Option B); pair with AUTH_TRUST_PROXY_HEADERS=true + the Cloudflare CIDRs.
# Default ":80" keeps Caddy from failing if ARTHOS_DOMAIN is unset.

{$ARTHOS_DOMAIN::80} {
    # Route API requests to the FastAPI backend
    handle /api/* {
        reverse_proxy api:8000
    }

    # Serve the pre-built React SPA for everything else.
    # The `try_files` directive enables client-side routing.
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }

    # Compress responses
    encode gzip zstd

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
