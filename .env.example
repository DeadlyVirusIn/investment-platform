# ──────────────────────────────────────────────────────────────
#  Investment Platform — Environment Variables
#  Copy to .env and fill in real values. NEVER commit .env.
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL (used by docker-compose) ───────────────────────
POSTGRES_USER=invest
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=investment_platform

# ── SQLAlchemy / Alembic connection string ─────────────────────
# psycopg v3 sync driver — used by both API and Alembic.
DATABASE_URL=postgresql+psycopg://invest:change_me_strong_password@localhost:5432/investment_platform

# ── Tiingo data provider ───────────────────────────────────────
# Free tier: 500 req/hour EOD, 1000 IEX ticks/hour
# Re-verify limits before Phase 1 — see docs/data-providers.md
TIINGO_API_KEY=your_tiingo_api_key_here

# ── Encryption (Fernet symmetric key) ─────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here

# ── Application ────────────────────────────────────────────────
APP_VERSION=0.0.1
LOG_LEVEL=info

# ── Options (Phase 11O / 11O.1 — manual paper evaluation only) ─
# All flags optional. OPTIONS_ENABLED must be explicitly true to run
# scripts/run_options_paper_eval.py. OPTIONS_PAPER_ONLY is permanent
# v1 (do NOT set to false). OPTIONS_ML_CAN_AFFECT_TRADES must stay
# false. The runner validates these at startup.
# OPTIONS_ENABLED=false
# OPTIONS_PAPER_ONLY=true
# OPTIONS_ML_CAN_AFFECT_TRADES=false
# OPTIONS_DATA_PROVIDER=thetadata

# ── ThetaData provider (Phase 11O.1) ───────────────────────────
# Required when OPTIONS_DATA_PROVIDER=thetadata AND OPTIONS_ENABLED=true.
# Theta Terminal default: http://127.0.0.1:25510 (no auth required).
# THETADATA_BASE_URL=http://127.0.0.1:25510
# Bearer token (preferred). Leave blank for local Theta Terminal.
# THETADATA_API_KEY=
# Basic-auth alternative. Leave blank if using API key or no auth.
# THETADATA_USERNAME=
# THETADATA_PASSWORD=
# Per-request timeout (seconds).
# THETADATA_TIMEOUT_SECONDS=30
# Retries on 5xx / connection errors only. Never retries 4xx.
# THETADATA_MAX_RETRIES=2
# Client-side rate limit (queries per second).
# THETADATA_RATE_LIMIT_QPS=5.0
